#!/bin/sh
# 快速版檢查；完整檢查與跳過的步驟見 docs/development.md〈全部檢查〉。
cd "$(git rev-parse --show-toplevel)" || exit 1

# git 給 hook 的 GIT_DIR、GIT_INDEX_FILE 會被 cargo xtask 底下的工具繼承，在暫存目錄跑的 git 就改到這個 repo 的 index。
for name in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$name"
done

exec cargo xtask check --fast
