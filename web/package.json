		"e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.6",
		"typescript": "~7.0.2",
		"vite": "^8.3.5"
	}
}
